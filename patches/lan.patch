+            })
+            .catch(function (error) {
+              if (error && error.message !== "unauthorized") {
+                setStatus("识图失败：" + error.message, false);
+              }
+            });
+        }
+
+        function errorText(status, data) {
+          if (status === 413) {
+            return "图片太大（上限 8 MB）";
+          }
+          if (status === 415) {
