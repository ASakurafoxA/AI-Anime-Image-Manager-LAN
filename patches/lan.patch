+ */
+export function generateRandomPassword(length: number): string {
+  const bytes = crypto.randomBytes(length);
+  let password = "";
+  for (const byte of bytes) {
+    password += RANDOM_ALPHABET[byte % RANDOM_ALPHABET.length];
+  }
+  return password;
+}
+
+/* ── 永久口令 ─────────────────────────────────────────────── */
+
+/**
+ * 设置永久口令。
