+
+        /* 视图大小：4 档，手机默认第 1 档、电脑默认更大（用户点过就记住） */
+        var CELL_STEPS = [
+          { label: "小", px: 104 },
+          { label: "中", px: 140 },
+          { label: "大", px: 190 },
+          { label: "特大", px: 250 },
+        ];
+        var CELL_KEY = "aim_lan_cell_step";
+
+        function defaultSizeIndex() {
+          var w = window.innerWidth || 390;
+          if (w >= 1400) {
+            return 3;
+          }
+          if (w >= 1000) {
