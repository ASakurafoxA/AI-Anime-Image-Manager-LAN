+
+/**
+ * 自用：把诊断内容导出成**单个 Markdown 文件**（给 AI 排查用）。
+ *
+ * 与 `createDiagnosticBundle` 的区别：**不打包 ZIP**。
+ * 一个纯文本文件最省事 —— AI 直接就能读，不用先解压；也方便整份复制进对话。
+ * 复用的是同一套采集与脱敏（`assembleDiagnosticEntries`），所以隐私口径完全一致。
+ */
+export async function createDiagnosticLogExport(
+  input: DiagnosticBundleInput
+): Promise<DiagnosticLogExportResult> {
+  const incident = resolveIncident(input);
+  const entries = await assembleDiagnosticEntries(incident, input);
+  const markdown = composeAgentReadableLog(entries, incident);
+  const outputPath = getUniqueLogPath(incident.id);
+  fs.writeFileSync(outputPath, markdown, "utf-8");
+  return { markdown, path: outputPath, warnings: entries.warnings };
+}
+
+/**
+ * 拼成"人看得懂、AI 也好解析"的单文件：
+ * 结构化的 Markdown 标题 + 报告正文 + 机器可读的 JSON 摘要 + 原始日志。
+ */
+function composeAgentReadableLog(
+  entries: BundleEntries,
+  incident: StoredDiagnosticIncident
+): string {
+  // 日志正文里可能自带 ``` ，用 4 个反引号包住，免得把 Markdown 结构弄坏
+  const fence = "````";
+  const lines: string[] = [
+    "# AI Image Manager 诊断日志 / Diagnostics log",
+    "",
+    `- 生成时间 / Generated: ${new Date().toISOString()}`,
+    `- 故障编号 / Incident: ${incident.id}`,
+    `- 指纹 / Fingerprint: ${incident.fingerprint}`,
+    `- 来源 / Source: ${incident.source}`,
+    "",
+    "> 本文件在你的电脑上本地生成，且已自动脱敏：不含文件路径、图片文件名、机器名、账号与密钥。",
+    "> This file was generated locally and is automatically redacted.",
+    "> 直接把整份内容交给 AI 即可排查 / Hand the whole file to an AI to diagnose.",
+    "",
+    "---",
+    "",
+    entries.report.trim(),
+    "",
+    "---",
+    "",
+    "## 机器可读摘要 / Machine-readable manifest",
+    "",
+    `${fence}json`,
+    JSON.stringify(entries.manifest, null, 2),
+    fence,
+    "",
+    "## 近期日志（已脱敏）/ Recent logs (redacted)",
+    "",
+    `${fence}log`,
+    entries.logs.trim(),
+    fence,
+  ];
+  if (entries.warnings.length > 0) {
+    lines.push("", "## 采集过程中的警告 / Collection warnings", "");
+    for (const warning of entries.warnings) {
+      lines.push(`- ${warning}`);
+    }
+  }
+  return `${lines.join("\n")}\n`;
+}
+
+/** 放到"下载"目录，和 ZIP 包同一处，文件名只差扩展名。 */
+function getUniqueLogPath(incidentId: string): string {
+  const directory = app.getPath("downloads");
+  fs.mkdirSync(directory, { recursive: true });
+  const baseName = `AI-Image-Manager-Diagnostics-${incidentId}`;
+  let candidate = path.join(directory, `${baseName}.md`);
+  let suffix = 2;
+  while (fs.existsSync(candidate)) {
+    candidate = path.join(directory, `${baseName}-${suffix}.md`);
+    suffix += 1;
+  }
+  return candidate;
 }
 
