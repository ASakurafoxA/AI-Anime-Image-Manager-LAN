@@ -0,0 +1,2265 @@
+/**
+ * Danbooru 画师 / 角色 / 作品系列的**中文名对照表**（自用新增 2026-10-09）。
+ *
+ * ── 为什么需要这张表 ─────────────────────────────────────────────
+ * 现有的 `zh_names.csv`（WD14 通用标签表，23,799 行）**只有通用标签**
+ * （`1girl` / `long_hair` 那类），**完全没有**角色、画师、作品系列。
+ * 所以换到 PixAI 之后，`角色` / `画风` / `作品系列` 三个目录里全是一长串罗马音
+ * （`suzuran_(arknights)`、`shiratama_(shiratamaco)`），用户看不懂也搜不到。
+ *
+ * ── 数据来源（务必保留出处，便于日后更新）─────────────────────────
+ *   https://github.com/ffdkj/ffdkj-Danbooru_Tag-Chinese-English-Translation-Table
+ *   该仓库每日更新 `tag.sqlite`（name / category / cn_name / post_count），
+ *   覆盖 Danbooru 上 post_count >= 10 的 33 万条标签。
+ *   我们只取 category ∈ {1 艺术家, 3 版权, 4 角色} 且能对上 PixAI 词表的部分。
+ *
+ * ── 收录口径（用户 2026-10-09 确认，宁缺勿错）────────────────────
+ *   · 角色 / 作品系列：优先**能看懂的官方中文名**（简体优先）
+ *   · 画师：**不做翻译**，只采用"真正的原名"（日文汉字名 / 中文名）。
+ *     混了拉丁字母的（`大川bkub`）、外号化的（`炸虾人`）、常见词直译的（`bow` → 蝴蝶结）
+ *     一律**丢掉** —— 查不到就维持罗马音原名，绝不硬造。
+ *   · 表里没有的标签 → 保持英文原名（见 `displayNameFor` 的回落逻辑）
+ *
+ * ── 落库格式 ──────────────────────────────────────────────────
+ *   `中文名 (english_original)`，与既有通用标签完全一致（括号前一个空格）。
+ *   `baseNameOf()` 能从中还原英文原名，保证**中英文都能搜到**、且可逆。
+ *
+ * ⚠️ 本文件由 `需求分析/_perf/export_l10n_ts.py` 生成，请勿手改。
+ */
+
+
+/** LAN版 WD14 词表里的角色（2232 条） */
+export const WD14_CHARACTER_ZH: Record<string, string> = {
+  "abe_nana": "安部菜菜",
+  "abigail_williams_(fate)": "阿比盖尔·威廉姆斯",
+  "abigail_williams_(swimsuit_foreigner)_(third_ascension)_(fate)": "阿比盖尔·威廉姆斯（swimsuit foreigner·third ascension）",
+  "abigail_williams_(third_ascension)_(fate)": "阿比盖尔·威廉姆斯（third ascension）",
+  "abigail_williams_(traveling_outfit)_(fate)": "阿比盖尔·威廉姆斯（traveling outfit）",
+  "absol": "阿勃梭鲁",
+  "accelerator_(toaru_majutsu_no_index)": "一方通行",
+  "acerola_(pokemon)": "阿塞萝拉",
+  "achilles_(fate)": "阿喀琉斯",
+  "adachi_rei": "足立玲",
+  "adaman_(pokemon)": "刚石",
+  "admiral_graf_spee_(azur_lane)": "斯佩伯爵海军上将",
+  "admire_vega_(umamusume)": "爱慕织姬",
+  "adult_neptune": "成年涅普图努",
+  "adventurer_(ff11)": "冒险者（ff11）",
+  "adventurer_(ff14)": "冒险者",
+  "aegir_(azur_lane)": "埃吉尔",
+  "aerith_gainsborough": "爱丽丝·盖恩斯巴勒",
